{
    "name": "pvu-tiles-worker",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "ts-node src/server.ts",
        "dev:node": "ts-node --watch src/server.ts",
        "build:node": "tsc",
        "dev:worker": "wrangler dev src/worker.ts",
        "deploy:worker": "wrangler deploy --minify src/worker.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.9",
        "hono": "^4.11.8",
        "pmtiles": "^3.0.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20240117.0",
        "@types/node": "^25.2.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.0",
        "wrangler": "^3.0.0"
    }
}